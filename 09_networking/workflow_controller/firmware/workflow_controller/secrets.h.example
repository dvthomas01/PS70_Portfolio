/**
 * Copy to secrets.h and fill in values. secrets.h is gitignored.
 */
#ifndef WORKFLOW_CONTROLLER_SECRETS_H
#define WORKFLOW_CONTROLLER_SECRETS_H

namespace secrets {

constexpr const char* WIFI_SSID = "YOUR_SSID";
constexpr const char* WIFI_PASSWORD = "YOUR_PASSWORD";

/** LAN IPv4 of the Mac running the Python WebSocket server (e.g. "192.168.1.42"). */
constexpr const char* WEBSOCKET_HOST = "192.168.1.42";

}  // namespace secrets

#endif  // WORKFLOW_CONTROLLER_SECRETS_H
